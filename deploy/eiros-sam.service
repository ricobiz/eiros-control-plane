[Unit]
Description=EIROS Self-Awake Mechanism supervisor
After=network-online.target eiros-worker.service
Wants=network-online.target eiros-worker.service

[Service]
Type=simple
User=eiros
Group=eiros
WorkingDirectory=/opt/eiros-control-plane
ExecStartPre=/opt/eiros-control-plane/venv/bin/python -c "import runtime.sam"
ExecStart=/opt/eiros-control-plane/venv/bin/python -m runtime.sam daemon
Restart=always
RestartSec=3
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/eiros-control-plane /tmp

[Install]
WantedBy=multi-user.target
