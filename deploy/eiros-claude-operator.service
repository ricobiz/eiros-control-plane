[Unit]
Description=EIROS Claude Full Operator MCP
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/eiros-control-plane
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/eiros-control-plane/venv/bin/python -m runtime.claude_operator_mcp_server
Restart=always
RestartSec=3
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
