# Copy to /etc/eiros/musetalk-jobs.env and chmod 600.
# Never commit the real API key.
EIROS_RUNPOD_API_KEY=
EIROS_RUNPOD_POD_ID=
EIROS_RUNPOD_TARGET_FILE=/opt/eiros-control-plane/runtime/runpod_target.json
EIROS_RUNPOD_KEY_FILE=/root/.ssh/eiros_runpod
EIROS_MUSETALK_STATE_ROOT=/var/lib/eiros/musetalk-jobs
EIROS_MUSETALK_IDLE_GRACE_SECONDS=120
EIROS_MUSETALK_TICK_SECONDS=2
