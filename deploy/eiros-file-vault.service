[Unit]
Description=EIROS File Vault MCP and private browser upload service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/eiros-control-plane
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/eiros/file-vault.env
UMask=0077
ExecStartPre=/opt/eiros-control-plane/venv/bin/python -c "import runtime.file_vault_mcp_server"
ExecStart=/opt/eiros-control-plane/venv/bin/python -m runtime.file_vault_mcp_server
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
